# Cloudflare Pages headers. Hashed assets never change, so cache them forever;
# the HTML shell and service worker must always be revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
