{
  "name": "tiny-empires",
  "version": "1.0.0",
  "private": true,
  "description": "TINY EMPIRES — a browser civilization-building game",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:smoke": "python3 scripts/smoke_test.py"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "engines": {
    "node": ">=20"
  }
}
